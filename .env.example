# =============================================================================
# Опора — пример переменных окружения.
# Скопируйте файл в .env и заполните значения. .env не коммитится в Git.
# =============================================================================

# Основное
PORT=3000
NODE_ENV=development
TZ=Europe/Kaliningrad

# Пароль в кабинет врача. ОБЯЗАТЕЛЬНО смените перед публикацией.
DOCTOR_PASSWORD=opora-demo-2026

# Случайная строка для подписи сессий врача.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-secret

# Telegram-уведомления.
# 1) Создайте бота у @BotFather и вставьте токен.
# 2) Получатель (@Sson1ta) должен нажать /start в этом боте.
# 3) Узнайте numeric chat_id (например, через @userinfobot) и вставьте сюда.
# Можно несколько получателей через запятую.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Необязательно: адрес Telegram API (для тестов с локальной заглушкой).
# TELEGRAM_API_BASE=https://api.telegram.org

# Необязательно: защита от спама тревожной кнопкой, секунды.
ALARM_COOLDOWN_SEC=120

# -----------------------------------------------------------------------------
# База данных.
# Если DATABASE_URL не задан, используется встроенный PGlite (файл в ./data).
# На бесплатном хостинге без постоянного диска данные могут сброситься.
# Для сохранения данных подключите бесплатный PostgreSQL (Neon/Supabase) или
# PostgreSQL в РФ для реальной эксплуатации.
# Пример: postgresql://user:password@host/db?sslmode=require
# -----------------------------------------------------------------------------
DATABASE_URL=
# DATABASE_SSL=require
# PGLITE_DIR=./data/pglite
